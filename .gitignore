.env
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
config/agent_config.json

# config/store.py's fallback encryption key for MCP connection credentials
# (only generated when NAVI_MCP_SECRET_KEY isn't set) — never commit a
# secret key next to the ciphertext it protects.
config/.mcp_secret.key

# storage/conversations.py's SQLite store — per-instance runtime state
# (chat/Dev Slate conversation history), same reasoning as
# config/agent_config.json above, not something to ship in the repo.
conversations.db

# storage/agent_work.py's SQLite store (Agent Work workflow/run/step
# history) — same reasoning as conversations.db above.
agent_work.db

# storage/usage.py's SQLite store (Usage counters panel's per-day request/
# token/Neuron counts + Groq rate-limit snapshots) — same reasoning.
usage.db

# storage/sources.py's SQLite store (Sources tab's saved documents + batch
# status) — same reasoning.
sources.db

# storage/agents.py's SQLite store (Agent Vault's starred/saved agents) —
# same reasoning. Missed when the others above were added; only surfaced
# once local testing actually created the file (2026-09-08).
agents.db

# storage/auth.py's SQLite store (real user accounts/sessions, 2026-09-10)
# — same reasoning as the other *.db files above, PLUS this one actually
# holds real password hashes/session tokens, not just app state.
auth.db

# Local-only running notes across Claude Code sessions — scratch
# continuity, not project documentation, not meant to be committed.
# Auto-loaded via CLAUDE.md's @IDEAS.md import.
IDEAS.md

# Same reasoning as IDEAS.md above — persistent design doc for chat/
# topic/Agent-Work context handling specifically, auto-loaded via
# CLAUDE.md's @how_to_handle_context.md import.
how_to_handle_context.md

# Same reasoning as IDEAS.md above — secondary market-research notes
# (naming/legal/funding-adjacent business continuity, not project docs).
MARKET_RESEARCH.md

# Same reasoning as IDEAS.md above — session audit-trail changelog for
# Agent Work reliability features, local continuity notes rather than
# project documentation.
AGENT_WORK_RELIABILITY.md

# Same reasoning as IDEAS.md above — session audit-trail changelog for
# real accounts/roles/permissions.
ACCOUNTS_AND_ROLES.md

# Scratch diagnostic payloads (curl -d @file.json tests) — throwaway, not
# part of the app, shouldn't be committed.
*_test_payload.json

# Claude Code's own local working context — machine-local tooling state,
# not part of the shipped app. Was already ignored incidentally via some
# global gitconfig; declared explicitly here so it stays ignored for
# anyone else who clones this repo too, not just this machine.
.claude/

# jobs/classify_topic.py's local session state — scratch, not app data.
topic_classifier_state.json

# One-off downloaded catalog snapshots from live investigation this
# session (Artificial Analysis, OpenRouter, LLM7 model lists) — point-in-
# time reference dumps, not app data, go stale immediately, shouldn't be
# committed.
aa_models.json
or_models.json
llm7_models.json

# jobs/model_ranking.py's own generated output — a live snapshot
# regenerated on every run, not app data, goes stale immediately.
model_ranking_snapshot.json
aa_benchmarks_cache.json